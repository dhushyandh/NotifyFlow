# ==============================================================================
# NotifyFlow Environment Variables Template
# Copy this file to apps/api/.env and replace placeholder values.
# Do NOT commit .env containing real secrets into version control.
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL / Neon)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Internal Security
# Secret key used for authenticating internal operations (e.g., PATCH /api/v1/notifications/:id/status)
INTERNAL_API_KEY="your-internal-api-secret-key"

# Resend Email Provider Configuration
RESEND_API_KEY="re_123456789_abcdefghijklmnopqrstuvwxyz"
EMAIL_FROM="NotifyFlow <onboarding@resend.dev>"

# Background Worker Configuration
# Polling interval in milliseconds (minimum 250ms, defaults to 1000ms)
WORKER_POLL_INTERVAL_MS=1000
